---
import Base from '../layouts/Base.astro';
import '../styles/simple.css';
import SHero from '../components/simple/SHero.svelte';
import Gap, { type GapRow } from '../components/simple/Gap.svelte';
import Wall, { type WallTile, type GoalGap } from '../components/simple/Wall.svelte';
import WrongObject from '../components/simple/WrongObject.svelte';
import Fragile from '../components/simple/Fragile.svelte';
import Backbone, { type BackboneRow, type Cls, type DecodeExample } from '../components/simple/Backbone.svelte';
import Futures from '../components/simple/Futures.svelte';
import Instruction from '../components/Instruction.svelte';
import vqaData from '../../public/data/vqa.json';
import episodes from '../../public/data/episodes.json';
import { epId, href, type Episode } from '../lib/media';
import { study, MODELS, GOALS, SCENES, FORM_ORDER, FORM_NAME, FORM_SHORT, MODEL_NAME, goalByKey, outcomeOf } from '../lib/study';
import { VQA_GOALS, type VqaPublic } from '../lib/vqa';
import { FC } from '../lib/forecasts';
import { SITE } from '../lib/site';

const all = episodes as Episode[];
const byId = new Map(all.map((e) => [e.id, e]));
const ep = (id: string) => {
  const e = byId.get(id);
  if (!e) throw new Error(`missing episode ${id}`);
  return e;
};
const fail = (msg: string): never => {
  throw new Error(`home page: ${msg}`);
};
const full = (anchor: string) => `${href('details/')}#${anchor}`;

// The question: one goal, three wordings, and the design that multiplies to every rollout.
const goal = goalByKey('S4-R');
const STARTS = study.settings.stats.starts / SCENES.length;
const design = [
  [MODELS.length, 'models'],
  [GOALS.length, 'goals'],
  [FORM_ORDER.length, 'wordings'],
  [STARTS, 'starts'],
] as const;
if (design.reduce((p, [n]) => p * n, 1) !== study.flow.total) fail('design does not multiply to the episode count');

// 01 · The wording gap: placement rate per model and wording, scenes weighted equally.
const head = study.contrasts.TF_RF.anytime.All;
const disc = study.contrasts.TF_RF.discordant;
const gapRows: GapRow[] = MODELS.map((m) => {
  const r = study.rates.byModelForm[m.id as keyof typeof study.rates.byModelForm];
  return { id: m.id, name: m.name, D: r.D.anytime, S: r.S.anytime, I: r.I.anytime };
});
if (gapRows.some((r) => r.S <= r.I)) fail('the target-first advantage should hold for every model');

// 02 · One goal up close: every start of the mustard-right goal, plus how far each goal moved.
const wallTiles = {} as Record<'S' | 'I', WallTile[]>;
for (const f of ['S', 'I'] as const) {
  wallTiles[f] = MODELS.flatMap((m) =>
    Array.from({ length: STARTS }, (_, i) => {
      const e = ep(epId(m.id, goal.scene.id, i + 1, goal.id, f));
      return { id: e.id, m: m.id, c: i + 1, o: outcomeOf(e) };
    }),
  );
}
const rel = (key: string) => study.relation.find((r) => r.key === key) ?? fail(`missing relation ${key}`);
const placed = (f: 'S' | 'I') => wallTiles[f].filter((t) => t.o !== 'never').length;
if (placed('S') !== rel(goal.key).tf || placed('I') !== rel(goal.key).rf) fail('wall tiles disagree with the relation table');
const gaps: GoalGap[] = study.relation.map((r) => ({ key: r.key, label: goalByKey(r.key).label, d: -Math.round(100 * r.est) }));
if (gaps.length !== GOALS.length) fail('expected one gap per goal');

// 03 · The reversal goal: every reference-first success moved the bowl and never lifted the cube.
const wrongKey = 'S1-B';
const wrongGoal = goalByKey(wrongKey);
const rfWins = all.filter((e) => `${e.s}-${e.g}` === wrongKey && e.f === 'I' && e.se);
if (rfWins.length !== rel(wrongKey).rf) fail('reference-first successes disagree with the relation table');
if (rfWins.some((e) => !e.refMoved || e.tLift !== null)) fail('a reference-first success on the reversal goal lifted the cube');
const reversals = study.relation.filter((r) => r.rf > r.tf);
if (reversals.length !== 1 || reversals[0].key !== wrongKey) fail('expected exactly one goal where reference-first wording wins');
const wrongTF = ep(epId('N3', wrongGoal.scene.id, 8, wrongGoal.id, 'S'));
const wrongRF = ep(epId('N3', wrongGoal.scene.id, 8, wrongGoal.id, 'I'));
if (wrongTF.se || !wrongRF.sf) fail('the wrong-object pair no longer shows a failure next to a kept success');

// 05 · The language backbone, text only, on the ten goals without bowl stacking.
const vqa = vqaData as unknown as VqaPublic;
const CLS: Record<string, Cls> = { correct: 'c', converse_relation: 'r' };
const ORDER: Record<Cls, number> = { c: 0, r: 1, o: 2 };
const backboneRows: BackboneRow[] = MODELS.map((m) => {
  const lane = vqa.lanes[m.id as keyof typeof vqa.lanes];
  const cells = FORM_ORDER.map((f, fi) => {
    const dots = VQA_GOALS.map((g) => {
      const q = lane.b2[`B2.T.${g.key}-${f}`] ?? fail(`missing text-only answer ${m.id} ${g.key}-${f}`);
      return CLS[q[2]] ?? 'o';
    }).sort((a, b) => ORDER[a] - ORDER[b]);
    const ok = dots.filter((d) => d === 'c').length;
    if (ok !== study.vqa.summary.text[m.id as keyof typeof study.vqa.summary.text][fi]) fail(`text-only score mismatch ${m.id} ${f}`);
    return { f, dots };
  });
  const images = study.vqa.summary.imagesCamera[m.id as keyof typeof study.vqa.summary.imagesCamera][2];
  return { id: m.id, name: m.name, short: m.short, lm: m.lm, cells, images };
});
const decodeModel = MODELS.find((m) => m.id === 'F3') ?? fail('missing FLUX');
const decodePrompt = vqa.prompts[`${goal.key}-I`] ?? fail('missing decode prompt');
const decodeAnswer = vqa.lanes.F3.b2[`B2.T.${goal.key}-I`];
if (decodeAnswer[2] !== 'converse_relation') fail('decode example is no longer a reversal');
const tokens = vqa.lanes.F3.seqs[decodeAnswer[1]].filter((t) => t !== '<|im_end|>');
const relAt = tokens.indexOf('relation');
const badEnd = tokens.indexOf('"}', relAt);
const bad: [number, number] = [relAt + 3, badEnd];
const said = tokens.slice(...bad).join('');
const gold = decodePrompt.gold.relation;
if (relAt < 0 || badEnd < 0 || said !== 'left_of' || gold !== 'right_of') fail(`unexpected decode ${said} vs ${gold}`);
const decode: DecodeExample = { instruction: decodePrompt.instruction, tokens, bad, said, gold, model: decodeModel.name, lm: decodeModel.lm };

// 06 · Forecasts: pooled change in held-out Brier score from adding the video labels.
const pooled = FC.utility.rows.find((r) => r.model === 'All') ?? fail('missing pooled forecast row');

const checks = [
  ['Pair the wordings', 'Run equivalent instructions from identical starts, and report every relation, not only the average.'],
  ['Check the object', 'Verify that the intended object moved, not just that the relation became true.'],
  ['Check the ending', 'Confirm the requested arrangement still holds when the episode ends.'],
  ['Test the language model', 'Probe the backbone on the same goals, with and without images.'],
] as const;
---

<Base page="home" sections={[]} extra={[[href('details/'), 'Full results'], [SITE.code, 'Code']]}>
  <script is:inline define:vars={{ to: href('details/') }}>
    // Section links shared before the detailed page moved to /details/.
    const moved = () => {
      if (/^#(intro|finding|setup|results|failures|language|forecasts|takeaways)(-|$)/.test(location.hash)) location.replace(to + location.hash);
    };
    moved();
    addEventListener('hashchange', moved);
  </script>
  <SHero client:load tf={ep(epId('E3', goal.scene.id, 2, goal.id, 'S'))} rf={ep(epId('E3', goal.scene.id, 2, goal.id, 'I'))} />

  <section class="section q" id="question">
    <div class="wrap">
      <header class="pk-head">
        <div class="pk-k">The question</div>
        <h2 class="pk-h">If a robot understands the goal, <em>the wording shouldn’t matter.</em></h2>
        <p class="pk-p">
          World-action models turn an instruction and camera views into robot actions, while predicting what the cameras will see next. To
          place an object, the model has to work out which object to move and where it belongs relative to another. The same placement can
          be described from either object’s side. We asked three released models to make the same placement, from the same start, under
          three equivalent wordings.
        </p>
      </header>

      <ol class="words" aria-label={`Three wordings of one goal: ${goal.label.toLowerCase()}`}>
        {
          FORM_ORDER.map((f, i) => (
            <li class={`word ${f}`}>
              <div class="word-top">
                <span class={`form-pill ${f}`}>{FORM_SHORT[f]}</span>
                <span class="word-name">{FORM_NAME[f]}</span>
              </div>
              <Instruction prompt={goal.prompts[f]} goal={goal} tag="p" />
              {i < FORM_ORDER.length - 1 && (
                <span class="eq" aria-hidden="true">
                  =
                </span>
              )}
            </li>
          ))
        }
      </ol>
      <p class="legend">
        <span class="tok-mover">mustard bottle</span> is the object to move, <span class="tok-ref">raisin box</span> is the reference. All three
        ask for the same arrangement, the mustard to the right of the box.
      </p>

      <div class="design" role="img" aria-label={`${design.map(([n, w]) => `${n} ${w}`).join(' × ')} = ${study.flow.total} rollouts`}>
        {
          design.map(([n, w], i) => (
            <span class="factor">
              {i > 0 && (
                <span class="op" aria-hidden="true">
                  ×
                </span>
              )}
              <span class="term" aria-hidden="true">
                <b class="pk-num">{n}</b>
                <span>{w}</span>
              </span>
            </span>
          ))
        }
        <span class="sum">
          <span class="op" aria-hidden="true">=</span>
          <span class="term total" aria-hidden="true">
            <b class="pk-num">{study.flow.total}</b>
            <span>rollouts</span>
          </span>
        </span>
      </div>
      <p class="pk-foot">
        Four simulated tabletop scenes. A rollout is scored a success when the requested arrangement holds steadily for the first time;
        simulator state is used only for scoring, never shown to the robot.
      </p>
    </div>
  </section>

  <Gap client:visible rows={gapRows} est={head.est} ci={head.ci as [number, number]} aOnly={disc.aOnly} bOnly={disc.bOnly} more={full('results')} />
  <Wall client:visible goalKey={goal.key} tiles={wallTiles} gaps={gaps} more={full('results')} />
  <WrongObject client:visible tf={wrongTF} rf={wrongRF} rfWins={rel(wrongKey).rf} tfWins={rel(wrongKey).tf} more={full('failures')} />
  <Fragile
    client:visible
    total={study.flow.total}
    anytime={study.flow.anytime}
    end={study.flow.end}
    initial={study.flow.maintenance.n}
    initialEnd={study.flow.maintenance.end}
    more={full('failures')}
  />
  <Backbone client:visible ex={decode} rows={backboneRows} more={full('language')} />
  <Futures
    client:visible
    id={epId('E3', goal.scene.id, 2, goal.id, 'I')}
    model={MODEL_NAME.E3}
    delta={pooled.delta}
    ci={FC.utility.ci}
    agree={FC.reported.allFieldsAgree}
    more={full('forecasts')}
  />

  <section class="section close" id="takeaways">
    <div class="wrap">
      <header class="pk-head">
        <div class="pk-k">The takeaway</div>
        <h2 class="pk-h">Success under one wording <em>is not steerability.</em></h2>
        <p class="pk-p">
          Every number on this page comes from the same {study.flow.total} rollouts, the same starts and the same scorer. To know whether a
          policy follows instructions, an evaluation should:
        </p>
      </header>
      <ol class="checks">
        {
          checks.map(([t, d], i) => (
            <li>
              <span class="ck-n" aria-hidden="true">
                {i + 1}
              </span>
              <b>{t}</b>
              <span>{d}</span>
            </li>
          ))
        }
      </ol>
      <div class="go">
        <a class="btn primary" href={href('explore/')}>Explore all {study.flow.total} rollouts →</a>
        <a class="btn" href={href('details/')}>Full results</a>
        {SITE.paper && <a class="btn" href={SITE.paper}>Paper (PDF)</a>}
        {!SITE.anonymous && SITE.code && <a class="btn" href={SITE.code}>Code</a>}
      </div>
      <div class="cite" id="cite">
        <div class="cite-head">
          <h3>Cite</h3>
          <button class="btn copy" type="button" data-copy>Copy BibTeX</button>
        </div>
        <pre><code data-bib>{SITE.bibtex}</code></pre>
        <p class="copied" role="status" aria-live="polite" data-status></p>
      </div>
    </div>
  </section>
</Base>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.close [data-copy]')) {
    const root = btn.closest('.cite')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    btn.addEventListener('click', async () => {
      const text = root.querySelector('[data-bib]')!.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        status.textContent = 'BibTeX copied to the clipboard.';
        btn.textContent = 'Copied ✓';
      } catch {
        const range = document.createRange();
        range.selectNodeContents(root.querySelector('[data-bib]')!);
        getSelection()?.removeAllRanges();
        getSelection()?.addRange(range);
        status.textContent = 'Selected. Press Ctrl+C or ⌘C to copy.';
      }
      setTimeout(() => {
        btn.textContent = 'Copy BibTeX';
        status.textContent = '';
      }, 2400);
    });
  }
</script>

<style>
  .words {
    list-style: none;
    margin: clamp(36px, 5vw, 56px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 44px;
  }

  .word {
    position: relative;
    padding: 20px 22px 22px;
    border-radius: 14px;
    background: var(--card);
    border: 1px solid var(--rule);
    box-shadow: var(--shadow);
  }

  .word-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .word-name {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .word :global(.instr) {
    margin: 14px 0 0;
    font-size: 1.12rem;
    line-height: 1.45;
    color: var(--ink);
  }

  .word.S {
    border-top: 3px solid var(--tf);
  }

  .word.I {
    border-top: 3px solid var(--rf);
  }

  .word.D {
    border-top: 3px solid var(--dir);
  }

  .eq {
    position: absolute;
    top: 50%;
    right: -33px;
    transform: translateY(-50%);
    font-family: var(--serif);
    font-size: 1.9rem;
    color: var(--faint);
  }

  .legend {
    margin: 22px 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--muted);
    max-width: 52em;
  }

  .design {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 6px clamp(14px, 2.4vw, 30px);
    margin-top: clamp(44px, 6vw, 72px);
    padding-top: clamp(28px, 4vw, 40px);
    border-top: 1px solid var(--rule);
  }

  .term {
    display: grid;
    justify-items: center;
    gap: 6px;
  }

  .factor,
  .sum {
    display: flex;
    align-items: flex-start;
    gap: clamp(14px, 2.4vw, 30px);
  }

  .term b {
    font-size: clamp(2.6rem, 1.6rem + 3.4vw, 4.6rem);
    color: var(--ink);
  }

  .term span {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .term.total b {
    color: var(--tf);
  }

  .op {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.4rem);
    line-height: clamp(2.6rem, 1.6rem + 3.4vw, 4.6rem);
    color: var(--faint);
  }

  @media (max-width: 560px) {
    .design {
      justify-content: space-between;
      column-gap: 4px;
    }

    .factor,
    .sum {
      gap: 6px;
    }

    .term span {
      font-size: 0.68rem;
      letter-spacing: 0.06em;
    }

    .sum {
      flex-basis: 100%;
    }
  }

  @media (max-width: 359px) {
    .factor,
    .sum {
      gap: 3px;
    }

    .term span {
      font-size: 0.64rem;
      letter-spacing: 0;
    }

    .op {
      font-size: 1.25rem;
    }
  }

  .checks {
    list-style: none;
    margin: clamp(36px, 5vw, 56px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .checks li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 16px;
    row-gap: 4px;
    padding: 22px 24px;
    border-radius: 14px;
    background: var(--card);
    border: 1px solid var(--rule);
  }

  .ck-n {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-family: var(--mono);
    font-size: 0.86rem;
  }

  .checks b {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
  }

  .checks li > span:last-child {
    color: var(--ink-2);
    line-height: 1.5;
  }

  .go {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .cite {
    margin-top: clamp(48px, 6vw, 72px);
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  .cite-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .cite h3 {
    font-size: 1.2rem;
  }

  .cite pre {
    margin: 16px 0 0;
    padding: 18px 20px;
    border-radius: 12px;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .copied {
    min-height: 1.4em;
    margin: 8px 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .words {
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }

    .eq {
      top: auto;
      right: auto;
      bottom: -31px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 1.6rem;
      line-height: 1;
    }

    .checks {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
